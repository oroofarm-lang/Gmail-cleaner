{
  "name": "inbox-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/dev-inbox.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core/*.test.ts tests/integrations/*.test.ts tests/*.test.mjs tests/backend/*.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integrations/*.test.ts tests/backend/*.test.mjs",
    "test:gmail-safety": "node --experimental-strip-types --test tests/core/safety.test.ts tests/backend/*.test.mjs",
    "test:security": "node --experimental-vm-modules --experimental-strip-types --test tests/security/*.test.mjs tests/extension.test.mjs",
    "test:performance": "node --experimental-strip-types tests/core/benchmark.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "format": "prettier --write app lib db packages tests agents docs scripts/dev-inbox.mjs scripts/release-check.mjs package.json README.md",
    "format:check": "prettier --check app lib db packages tests agents docs package.json README.md",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "test:visual": "playwright test --grep visual",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.9",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0",
    "fill-range": "^7.1.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    },
    "braces": "file:vendor/bounded-braces"
  }
}
