# Server-only Google Cloud OAuth web client ID.
GOOGLE_CLIENT_ID=
# Server-only Google client secret; never put this in web or extension code.
GOOGLE_CLIENT_SECRET=
# Exact HTTPS callback: <site-origin>/api/oauth/callback.
GOOGLE_REDIRECT_URI=
# Base64url-encoded 32 random bytes, stored in the host secret manager.
TOKEN_ENCRYPTION_KEY=
# Server-only OpenAI key. Optional: Privacy Mode and demo work without it.
OPENAI_API_KEY=
# Responses-compatible model ID configured explicitly by the operator.
OPENAI_MODEL=

# Operator opt-in after configuring/testing a real worker Cron trigger. Off by default.
GMAIL_SYNC_SCHEDULER=disabled
# Build-time, non-secret: set true to include a once-per-minute native Cron trigger.
INBOX_BUILD_SYNC_CRON=false

# Operator approval of provider/data terms; default disabled.
AI_PROCESSING=disabled
